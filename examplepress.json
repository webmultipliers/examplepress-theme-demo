{
	"$schema": "https://www.examplepress.com/schema/app",
	"name": "ExamplePress Demo",
	"slug": "examplepress-demo",
	"description": "Disposable demo companion plugin showing the routing contract, namespace handoff, and template block pattern.",
	"routing": {
		"priority": 10,
		"routes": {
			"front": {
				"condition": "is_front_page() || is_home()",
				"urls": [
					"/"
				],
				"desc": "Homepage"
			},
			"single": {
				"condition": "is_singular()",
				"urls": [
					"/hello-world/"
				],
				"desc": "Single post"
			},
			"404": {
				"condition": "is_404()",
				"urls": [
					"/nonexistent/"
				],
				"desc": "Not found"
			}
		}
	},
	"updater": {
		"github_repo": "webmultipliers/examplepress-theme-demo",
		"asset_filename": "examplepress-theme-demo.zip",
		"default_channel": "stable",
		"requires_wp": "6.4",
		"requires_php": "8.1"
	},
	"troy": {
		"server_url": "",
		"repo": "",
		"repo_id": ""
	}
}